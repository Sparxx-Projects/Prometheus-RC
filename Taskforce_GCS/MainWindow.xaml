<Window x:Class="Taskforce_GCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PROMETHEUS TASKFORCE — GCS v2.0 [AETHERTERMINAL]" 
        Icon="Assets/sparxx_flame.png"
        Height="800" Width="1280"
        MinHeight="650" MinWidth="1024"
        Background="#0B0D13"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Estilos Tácticos Oscuros -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0D13"/>
        <SolidColorBrush x:Key="PanelBg" Color="#131720"/>
        <SolidColorBrush x:Key="BorderColor" Color="#222A38"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00F0FF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00FF88"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF3344"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FFAA00"/>
        <SolidColorBrush x:Key="TextDim" Color="#8B949E"/>
        <SolidColorBrush x:Key="TextBright" Color="#F0F6FC"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Consolas"/>
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1E2636"/>
            <Setter Property="BorderBrush" Value="#2D3A50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A374E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00F0FF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/> <!-- Header Bar -->
            <RowDefinition Height="54"/> <!-- Connectivity & Setup Bar -->
            <RowDefinition Height="*"/>  <!-- Main Content (Video + HUD + Telemetry) -->
            <RowDefinition Height="28"/> <!-- Status Footer -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER BAR -->
        <Border Grid.Row="0" Background="#0E121A" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título y Escuadrón con Logo Llama Sparxx -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/sparxx_flame.png" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="PROMETHEUS TASKFORCE" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                    <TextBlock Text=" | GCS v2.0 [AETHERTERMINAL]" FontWeight="Bold" FontSize="12" Foreground="#E0D4AC" VerticalAlignment="Center" Margin="6,2,0,0"/>
                </StackPanel>

                <!-- Badges de Estado Rápido -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Mando Xbox -->
                    <Border x:Name="BadgeMando" Background="#1B2230" CornerRadius="4" Padding="8,4" Margin="4,0" BorderBrush="#2D3A50" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotMando" Width="8" Height="8" Fill="{StaticResource AccentRed}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtMando" Text="MANDO XBOX: OFF" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                    </Border>

                    <!-- Enlace Robot -->
                    <Border x:Name="BadgeRobot" Background="#1B2230" CornerRadius="4" Padding="8,4" Margin="4,0" BorderBrush="#2D3A50" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotRobot" Width="8" Height="8" Fill="{StaticResource AccentRed}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtRobot" Text="ENLACE COCHE: OFF" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                    </Border>

                    <!-- Stream Cámara -->
                    <Border x:Name="BadgeVideo" Background="#1B2230" CornerRadius="4" Padding="8,4" Margin="4,0" BorderBrush="#2D3A50" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotVideo" Width="8" Height="8" Fill="{StaticResource AccentRed}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtVideo" Text="CÁMARA: OFF" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. CONNECTIVITY & SETUP TOOLBAR -->
        <Border Grid.Row="1" Background="#121620" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="15,8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Configuración Enlace al Robot y Streaming Cámara 9S -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnConnectUdp" Content="⚡ ENLACE WI-FI UDP" Background="#0A3A40" BorderBrush="{StaticResource AccentCyan}" FontWeight="Bold" Height="28" Margin="0,0,15,0" Click="BtnConnectUdp_Click" ToolTip="Enlace directo al robot por Wi-Fi UDP (Ultra baja latencia, sin cables COM)"/>

                    <Rectangle Width="1" Height="24" Fill="#222A38" Margin="0,0,15,0"/>

                    <!-- Configuración ESP32-CAM Stream URL y Protocolo 9S Unificado -->
                    <TextBlock Text="URL CÁMARA:" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDim}" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtStreamUrl" Width="230" Height="28" Text="http://192.168.4.1:81/stream" Background="#1A202C" Foreground="#00F0FF" BorderBrush="#2D3A50" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,10,0"/>
                    <Button x:Name="BtnConnectStream" Content="⚡ INICIAR CÁMARA [AETHERTERMINAL]" Background="#2C2417" Foreground="#FFDE59" BorderBrush="#FFDE59" FontWeight="Bold" Height="28" Padding="12,0" ToolTip="Inicia la recepción de vídeo mediante el protocolo de intrusión de AetherTerminal" Click="BtnConnectStream_Click"/>
                </StackPanel>

                <!-- Botones Rápidos de Operación -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleSport" Content="⚡ MODO SPORT [LB]" Background="#1C2638" Height="28" Margin="0,0,6,0" Click="BtnToggleSport_Click"/>
                    <Button x:Name="BtnToggleTank" Content="🔄 GIRO TANQUE [RB]" Background="#1C2638" Height="28" Margin="0,0,6,0" Click="BtnToggleTank_Click"/>
                    <Button x:Name="BtnEmergencyStop" Content="⛔ PARADA EMERGENCIA [B]" Background="#881B26" BorderBrush="#FF3344" FontWeight="Bold" Height="28" Click="BtnEmergencyStop_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. MAIN WORKSPACE (VIEWPORT HUD + TELEMETRÍA) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>     <!-- Viewport de Vídeo y HUD Táctico -->
                <ColumnDefinition Width="340"/>   <!-- Panel Lateral de Telemetría y Controles -->
            </Grid.ColumnDefinitions>

            <!-- 3.1 VIEWPORT DE VÍDEO Y OVERLAY HUD TÁCTICO -->
            <Grid Grid.Column="0" Background="#07090D" ClipToBounds="True">
                <!-- Marco de fondo cuando no hay señal -->
                <Grid x:Name="NoSignalOverlay" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="[ NO SIGNAL — ESP32-CAM INACTIVA ]" FontSize="16" FontWeight="Bold" Foreground="#3A4659" HorizontalAlignment="Center" FontFamily="Consolas"/>
                        <TextBlock Text="Compruebe la conexión Wi-Fi a 'PROMETHEUS_CAM' o pulse 'INICIAR VÍDEO'" FontSize="12" Foreground="#2A3342" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Imagen del Stream de Vídeo MJPEG -->
                <Image x:Name="VideoPlayer" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>

                <!-- HUD TÁCTICO SOBREPUESTO (Canvas & Brackets) -->
                <Grid Margin="20">
                    <!-- Brackets de las 4 esquinas tácticas -->
                    <!-- Superior Izquierda -->
                    <Path Data="M 0,30 L 0,0 L 30,0" Stroke="{StaticResource AccentCyan}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBlock Text="CAM-01 [ESP32-CAM] // LATENCIA BAJA" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,6,0,0"/>

                    <!-- Superior Derecha -->
                    <Path Data="M 0,0 L 30,0 L 30,30" Stroke="{StaticResource AccentCyan}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,10,0">
                        <TextBlock x:Name="HudFpsText" Text="FPS: 0.0" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="HudLatencyText" Text="LATENCIA: 0 ms" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Inferior Izquierda -->
                    <Path Data="M 0,0 L 0,30 L 30,30" Stroke="{StaticResource AccentCyan}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                    <!-- Barra de aceleración vertical (RT) -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,40">
                        <TextBlock Text="ACEL [RT]" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextDim}"/>
                        <ProgressBar x:Name="HudThrottleBar" Orientation="Vertical" Width="10" Height="80" Minimum="0" Maximum="255" Value="0" Background="#151C28" Foreground="{StaticResource AccentGreen}" BorderThickness="0" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Inferior Derecha -->
                    <Path Data="M 30,0 L 30,30 L 0,30" Stroke="{StaticResource AccentCyan}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    <!-- Barra de freno/marcha atrás (LT) -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,40">
                        <TextBlock Text="FRENO [LT]" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextDim}"/>
                        <ProgressBar x:Name="HudBrakeBar" Orientation="Vertical" Width="10" Height="80" Minimum="0" Maximum="255" Value="0" Background="#151C28" Foreground="{StaticResource AccentRed}" BorderThickness="0" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- RETÍCULA MILITAR CENTRAL HUD -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Círculo Exterior -->
                        <Ellipse Width="120" Height="120" Stroke="#00F0FF" StrokeThickness="1" Opacity="0.35" StrokeDashArray="4 2"/>
                        <!-- Círculo Interior -->
                        <Ellipse Width="40" Height="40" Stroke="#00F0FF" StrokeThickness="1" Opacity="0.5"/>
                        <!-- Mira Cruz Central -->
                        <Line X1="-15" Y1="0" X2="-5" Y2="0" Stroke="{StaticResource AccentCyan}" StrokeThickness="1.5"/>
                        <Line X1="5" Y1="0" X2="15" Y2="0" Stroke="{StaticResource AccentCyan}" StrokeThickness="1.5"/>
                        <Line X1="0" Y1="-15" X2="0" Y2="-5" Stroke="{StaticResource AccentCyan}" StrokeThickness="1.5"/>
                        <Line X1="0" Y1="5" X2="0" Y2="15" Stroke="{StaticResource AccentCyan}" StrokeThickness="1.5"/>
                        <!-- Punto Central -->
                        <Ellipse Width="3" Height="3" Fill="{StaticResource AccentCyan}"/>
                    </Grid>

                    <!-- INDICADOR DE DIRECCIÓN DEL SERVO INFERIOR (Arco/Flecha) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
                        <TextBlock x:Name="HudSteeringText" Text="SERVO: 95° [CENTRO]" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <Grid Width="200" Height="14">
                            <!-- Fondo regla -->
                            <Rectangle Fill="#131B27" RadiusX="3" RadiusY="3"/>
                            <!-- Línea central (95°) -->
                            <Rectangle Width="2" Fill="{StaticResource AccentCyan}" HorizontalAlignment="Center"/>
                            <!-- Cursor de dirección dinámico -->
                            <Border x:Name="HudSteerCursor" Width="16" Height="14" Background="{StaticResource AccentGreen}" CornerRadius="2" HorizontalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="SteerTransform" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Banners Flotantes de Modos Tácticos -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,15,0,0">
                        <Border x:Name="HudSportBanner" Background="#DDAA00" CornerRadius="3" Padding="8,3" Margin="5,0" Visibility="Collapsed">
                            <TextBlock Text="⚡ MODO SPORT ACTIVADO (PWM 255)" FontWeight="Bold" FontSize="10" Foreground="#000000"/>
                        </Border>
                        <Border x:Name="HudTankBanner" Background="#00E5FF" CornerRadius="3" Padding="8,3" Margin="5,0" Visibility="Collapsed">
                            <TextBlock Text="🔄 GIRO TANQUE ACTIVO" FontWeight="Bold" FontSize="10" Foreground="#000000"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 3.1.2 OVERLAY DE HACKEO DE 9S (NieR: Automata Ver1.1a Authentic) -->
                <Grid x:Name="NierHackingOverlay" Visibility="Collapsed" Background="Transparent" ClipToBounds="True">
                    
                    <!-- ETAPA 1: CUADRÍCULA BLANCA TÁCTICA 9S (EARLY 14 A EARLY 16 - INICIALMENTE COLAPSADA) -->
                    <Grid x:Name="HackingLockStage" Background="#42000000" Visibility="Collapsed" Opacity="0.0">
                        
                        <!-- 1. ENCUADRE DE LAS 4 ESQUINAS TÁCTICAS EXTERIORES -->
                        <Grid Margin="35">
                            <!-- Superior Izquierda -->
                            <Path Data="M 0,70 L 0,0 L 70,0 M 0,35 L 25,35 M 35,0 L 35,25" Stroke="#FFFFFF" StrokeThickness="3.5" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Path.Effect>
                                    <DropShadowEffect Color="#FFFFFF" BlurRadius="20" ShadowDepth="0" Opacity="0.95"/>
                                </Path.Effect>
                            </Path>
                            <!-- Superior Derecha -->
                            <Path Data="M 0,0 L 70,0 L 70,70 M 70,35 L 45,35 M 35,0 L 35,25" Stroke="#FFFFFF" StrokeThickness="3.5" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Path.Effect>
                                    <DropShadowEffect Color="#FFFFFF" BlurRadius="20" ShadowDepth="0" Opacity="0.95"/>
                                </Path.Effect>
                            </Path>
                            <!-- Inferior Izquierda -->
                            <Path Data="M 0,0 L 0,70 L 70,70 M 0,35 L 25,35 M 35,70 L 35,45" Stroke="#FFFFFF" StrokeThickness="3.5" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <Path.Effect>
                                    <DropShadowEffect Color="#FFFFFF" BlurRadius="20" ShadowDepth="0" Opacity="0.95"/>
                                </Path.Effect>
                            </Path>
                            <!-- Inferior Derecha -->
                            <Path Data="M 70,0 L 70,70 L 0,70 M 70,35 L 45,35 M 35,70 L 35,45" Stroke="#FFFFFF" StrokeThickness="3.5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Path.Effect>
                                    <DropShadowEffect Color="#FFFFFF" BlurRadius="20" ShadowDepth="0" Opacity="0.95"/>
                                </Path.Effect>
                            </Path>
                        </Grid>

                        <!-- Halo de resplandor difuso suave de fondo -->
                        <Ellipse Width="800" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Color="#40FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#20FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00000000" Offset="1.0"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- 2. CONTENEDOR PRINCIPAL ESCALABLE (CUADRÍCULA TÁCTICA 9S UNIFICADA) -->
                        <Grid x:Name="HackingGridContainer" Width="800" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.Effect>
                                <DropShadowEffect Color="#FFFFFF" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/>
                            </Grid.Effect>
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="LockReticleScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.RenderTransform>

                            <!-- 8 CORCHETES ANGULARES RADIALES (EARLY 14 -> EARLY 17) -->
                            <Grid x:Name="RadialBarsGroup" Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="RadialBarsScale" ScaleX="0.85" ScaleY="0.85"/>
                                </Grid.RenderTransform>
                                <!-- 4 Diagonales a 45 grados -->
                                <Line X1="130" Y1="130" X2="100" Y2="100" Stroke="#FFFFFF" StrokeThickness="5" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
                                <Line X1="270" Y1="130" X2="300" Y2="100" Stroke="#FFFFFF" StrokeThickness="5" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
                                <Line X1="130" Y1="270" X2="100" Y2="300" Stroke="#FFFFFF" StrokeThickness="5" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
                                <Line X1="270" Y1="270" X2="300" Y2="300" Stroke="#FFFFFF" StrokeThickness="5" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
                                <!-- 4 Cardinales (Ortogonales) -->
                                <Line X1="200" Y1="110" X2="200" Y2="75" Stroke="#FFFFFF" StrokeThickness="4.5"/>
                                <Line X1="200" Y1="290" X2="200" Y2="325" Stroke="#FFFFFF" StrokeThickness="4.5"/>
                                <Line X1="110" Y1="200" X2="75" Y2="200" Stroke="#FFFFFF" StrokeThickness="4.5"/>
                                <Line X1="290" Y1="200" X2="325" Y2="200" Stroke="#FFFFFF" StrokeThickness="4.5"/>
                            </Grid>

                            <!-- 2 LÍNEAS HORIZONTALES (#) CON DESPLAZAMIENTO DINÁMICO -->
                            <Line x:Name="GridTopLine" X1="0" Y1="250" X2="800" Y2="250" Stroke="#FFFFFF" StrokeThickness="3.5">
                                <Line.RenderTransform>
                                    <TranslateTransform x:Name="TopLineTrans" Y="-35"/>
                                </Line.RenderTransform>
                            </Line>
                            <Line x:Name="GridBottomLine" X1="0" Y1="250" X2="800" Y2="250" Stroke="#FFFFFF" StrokeThickness="3.5">
                                <Line.RenderTransform>
                                    <TranslateTransform x:Name="BottomLineTrans" Y="35"/>
                                </Line.RenderTransform>
                            </Line>

                            <!-- 2 LÍNEAS VERTICALES (#) CON DESPLAZAMIENTO DINÁMICO -->
                            <Line x:Name="GridLeftLine" X1="400" Y1="0" X2="400" Y2="500" Stroke="#FFFFFF" StrokeThickness="3.5">
                                <Line.RenderTransform>
                                    <TranslateTransform x:Name="LeftLineTrans" X="-45"/>
                                </Line.RenderTransform>
                            </Line>
                            <Line x:Name="GridRightLine" X1="400" Y1="0" X2="400" Y2="500" Stroke="#FFFFFF" StrokeThickness="3.5">
                                <Line.RenderTransform>
                                    <TranslateTransform x:Name="RightLineTrans" X="45"/>
                                </Line.RenderTransform>
                            </Line>

                            <!-- 4 PUNTOS DE INTERSECCIÓN CON CRUCES BRILLANTES (+) -->
                            <!-- Intersección Superior Izquierda -->
                            <Canvas x:Name="IntersectionTL" Margin="400,250,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="IntersectionTLTrans" X="-45" Y="-35"/>
                                </Canvas.RenderTransform>
                                <Line X1="-35" Y1="0" X2="35" Y2="0" Stroke="#FFFFFF" StrokeThickness="5.5"/>
                                <Line X1="0" Y1="-35" X2="0" Y2="35" Stroke="#FFFFFF" StrokeThickness="5.5"/>
                                <Ellipse Canvas.Left="-5" Canvas.Top="-5" Width="10" Height="10" Fill="#FFFFFF"/>
                            </Canvas>

                            <!-- Intersección Superior Derecha -->
                            <Canvas x:Name="IntersectionTR" Margin="400,250,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="IntersectionTRTrans" X="45" Y="-35"/>
                                </Canvas.RenderTransform>
                                <Line X1="-35" Y1="0" X2="35" Y2="0" Stroke="#FFFFFF" StrokeThickness="5.5"/>
                                <Line X1="0" Y1="-35" X2="0" Y2="35" Stroke="#FFFFFF" StrokeThickness="5.5"/>
                                <Ellipse Canvas.Left="-5" Canvas.Top="-5" Width="10" Height="10" Fill="#FFFFFF"/>
                            </Canvas>

                            <!-- Intersección Inferior Izquierda -->
                            <Canvas x:Name="IntersectionBL" Margin="400,250,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="IntersectionBLTrans" X="-45" Y="35"/>
                                </Canvas.RenderTransform>
                                <Line X1="-35" Y1="0" X2="35" Y2="0" Stroke="#FFFFFF" StrokeThickness="5.5"/>
                                <Line X1="0" Y1="-35" X2="0" Y2="35" Stroke="#FFFFFF" StrokeThickness="5.5"/>
                                <Ellipse Canvas.Left="-5" Canvas.Top="-5" Width="10" Height="10" Fill="#FFFFFF"/>
                            </Canvas>

                            <!-- Intersección Inferior Derecha -->
                            <Canvas x:Name="IntersectionBR" Margin="400,250,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="IntersectionBRTrans" X="45" Y="35"/>
                                </Canvas.RenderTransform>
                                <Line X1="-35" Y1="0" X2="35" Y2="0" Stroke="#FFFFFF" StrokeThickness="5.5"/>
                                <Line X1="0" Y1="-35" X2="0" Y2="35" Stroke="#FFFFFF" StrokeThickness="5.5"/>
                                <Ellipse Canvas.Left="-5" Canvas.Top="-5" Width="10" Height="10" Fill="#FFFFFF"/>
                            </Canvas>

                            <!-- RETÍCULO CENTRAL DE PRECISIÓN Y AGUJAS LATERALES -->
                            <Line X1="375" Y1="250" X2="425" Y2="250" Stroke="#FFFFFF" StrokeThickness="2"/>
                            <Line X1="400" Y1="225" X2="400" Y2="275" Stroke="#FFFFFF" StrokeThickness="2"/>
                            <Ellipse Width="6" Height="6" Fill="#FFFFFF" Margin="397,247,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <!-- Agujas / Punteros Horizontales hacia el centro -->
                            <Polygon Points="330,250 370,248 376,250 370,252" Fill="#FFFFFF">
                                <Polygon.RenderTransform>
                                    <TranslateTransform x:Name="LeftNeedleTrans" X="-40" Y="0"/>
                                </Polygon.RenderTransform>
                            </Polygon>
                            <Polygon Points="470,250 430,248 424,250 430,252" Fill="#FFFFFF">
                                <Polygon.RenderTransform>
                                    <TranslateTransform x:Name="RightNeedleTrans" X="40" Y="0"/>
                                </Polygon.RenderTransform>
                            </Polygon>

                            <!-- Marcas Verticales Punteadas -->
                            <Line X1="400" Y1="180" X2="400" Y2="215" Stroke="#FFFFFF" StrokeThickness="2" StrokeDashArray="3 2">
                                <Line.RenderTransform>
                                    <TranslateTransform x:Name="TopNeedleTrans" X="0" Y="-30"/>
                                </Line.RenderTransform>
                            </Line>
                            <Line X1="400" Y1="285" X2="400" Y2="320" Stroke="#FFFFFF" StrokeThickness="2" StrokeDashArray="3 2">
                                <Line.RenderTransform>
                                    <TranslateTransform x:Name="BottomNeedleTrans" X="0" Y="30"/>
                                </Line.RenderTransform>
                            </Line>
                        </Grid>
                    </Grid>

                    <!-- ETAPA 2: DESTELLO BLANCO CEGADOR (0.7s - 0.9s) -->
                    <Rectangle x:Name="HackingWhiteFlash" Fill="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>

                    <!-- ETAPA 3: LA LEGENDARIA MATRIZ DORADA DE NIER: AUTOMATA (Parrilla Limpia) -->
                    <Grid x:Name="HackingMatrixStage" Opacity="0" Background="#060605">
                        <!-- Brillo general sobre la matriz dorada -->
                        <Grid.Effect>
                            <DropShadowEffect Color="#FFDC73" BlurRadius="18" ShadowDepth="0" Opacity="0.8"/>
                        </Grid.Effect>

                        <!-- Cuadrícula Matrix Dorada Idéntica al Vídeo -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,60,60" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#060605">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,60,60"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <!-- Líneas de Cuadrícula Ámbar / Doradas -->
                                            <GeometryDrawing>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#E2CD84" Thickness="2"/>
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <LineGeometry StartPoint="0,0" EndPoint="60,0"/>
                                                        <LineGeometry StartPoint="0,0" EndPoint="0,60"/>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <!-- Brillo en Intersecciones -->
                                            <GeometryDrawing Brush="#FFF6B5">
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="0,0" RadiusX="3" RadiusY="3"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Scanlines CRT horizontales -->
                        <Rectangle Opacity="0.18">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,1,4" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#000000">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,1,2"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Cartel Central Limpio y Legible de Acceso Concedido (Sin saturación de texto) -->
                        <Border x:Name="HackingSuccessBanner" Background="#E2CD84" CornerRadius="2" Padding="24,9" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="ACCESS GRANTED" FontWeight="Bold" FontSize="18" Foreground="#000000" FontFamily="Consolas"/>
                        </Border>
                    </Grid>

                    <!-- ETAPA 0: INTERFAZ REINVENTADA DE INTRUSIÓN Y HACKEO CYBERSPACE 9S (Z-INDEX SUPERIOR) -->
                    <Grid x:Name="HackingTerminalStage" Background="#F4080B10" Visibility="Collapsed" Opacity="0.0" Panel.ZIndex="100">
                        <!-- Círculo de resplandor difuso cian/ámbar de fondo -->
                        <Ellipse Width="650" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Color="#25FFDE59" Offset="0.0"/>
                                    <GradientStop Color="#08FFDE59" Offset="0.6"/>
                                    <GradientStop Color="#00000000" Offset="1.0"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Scanlines sutiles de terminal -->
                        <Rectangle Opacity="0.12" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,1,4" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#000000">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,1,2"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Marco de terminal táctica AetherTerminal con estética Cyberpunk y Logo Sparxx -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="680" Background="#111622" BorderBrush="#FFDE59" BorderThickness="1.5" CornerRadius="6" Padding="28,24">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFDE59" BlurRadius="28" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Cabecera AetherTerminal con Logo Llama Sparxx -->
                                <Grid Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="Assets/sparxx_flame.png" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="◆ AETHERTERMINAL // INTRUSION" FontFamily="Consolas" FontWeight="Bold" FontSize="14" Foreground="#FFDE59" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Border Background="#25FFDE59" CornerRadius="3" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="DATA-SPACE CYBERSYSTEM" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#FFDE59"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="TARGET: ESP32-CAM // 192.168.4.1:81" FontFamily="Consolas" FontSize="11" Foreground="#9EABB8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Separador cyber -->
                                <Border Height="1" Background="#40FFDE59" Margin="0,0,0,20"/>

                                <!-- NÚCLEO CENTRAL CON ANILLOS GIRATORIOS Y ESTADO -->
                                <Grid Height="140" Margin="0,0,0,20">
                                    <!-- Anillo exterior rotatorio segmentado -->
                                    <Ellipse x:Name="RingOuter" Width="130" Height="130" Stroke="#50FFDE59" StrokeThickness="2" StrokeDashArray="6 4" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="RingOuterRot" Angle="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <!-- Anillo medio rotatorio inverso -->
                                    <Ellipse x:Name="RingInner" Width="96" Height="96" Stroke="#9038EF7D" StrokeThickness="2" StrokeDashArray="4 3" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="RingInnerRot" Angle="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <!-- Anillo central de pulso -->
                                    <Ellipse Width="64" Height="64" Fill="#15FFDE59" Stroke="#FFDE59" StrokeThickness="1.5"/>

                                    <!-- Texto de Estado Central del Núcleo -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCoreStatus" Text="LOCKED" FontFamily="Consolas" FontWeight="Bold" FontSize="14" Foreground="#FFDE59" HorizontalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#FFDE59" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock x:Name="TxtCoreSub" Text="SECURITY CORE" FontFamily="Consolas" FontSize="8" Foreground="#88FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 3 MÓDULOS TÁCTICOS DE DEPENDENCIAS (DISEÑO CYBER-CARD PULIDO) -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Módulo 1: Cortafuegos -->
                                    <Border x:Name="BadgeDep1" Grid.Column="0" Background="#141926" BorderBrush="#354560" BorderThickness="1.5" CornerRadius="4" Padding="12,10" Margin="0,0,8,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="[01 // NET]" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#6C7F99"/>
                                                <TextBlock Text="🛡️ SUBNET" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="#95A8C0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="FIREWALL BYPASS" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                            <Border Background="#0C1018" CornerRadius="3" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse x:Name="DotDep1" Width="7" Height="7" Fill="#FFDE59" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="TxtDepStatus1" Text="BYPASSING..." FontSize="9.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#FFDE59"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Módulo 2: Dependencias de Red -->
                                    <Border x:Name="BadgeDep2" Grid.Column="1" Background="#141926" BorderBrush="#354560" BorderThickness="1.5" CornerRadius="4" Padding="12,10" Margin="4,0,4,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="[02 // KERN]" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#6C7F99"/>
                                                <TextBlock Text="🔗 SOCKETS" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="#95A8C0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="SYS DEPENDENCIES" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                            <Border Background="#0C1018" CornerRadius="3" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse x:Name="DotDep2" Width="7" Height="7" Fill="#557090" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="TxtDepStatus2" Text="PENDING" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#557090"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Módulo 3: Driver Óptico OV2640 -->
                                    <Border x:Name="BadgeDep3" Grid.Column="2" Background="#141926" BorderBrush="#354560" BorderThickness="1.5" CornerRadius="4" Padding="12,10" Margin="8,0,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="[03 // SENS]" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#6C7F99"/>
                                                <TextBlock Text="📷 OV2640" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="#95A8C0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="OPTICAL DRIVER" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                            <Border Background="#0C1018" CornerRadius="3" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse x:Name="DotDep3" Width="7" Height="7" Fill="#557090" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="TxtDepStatus3" Text="PENDING" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#557090"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Barra de Progreso Cyber con Porcentaje Dinámico -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="BarHackingProgress" Grid.Column="0" Height="8" Minimum="0" Maximum="100" Value="0" Background="#0C1018" Foreground="#FFDE59" BorderThickness="0" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtHackingPercent" Grid.Column="1" Text="0%" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#FFDE59" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="TxtHackingLogLine" Text="> Iniciando secuencia de hackeo de dependencias..." FontFamily="Consolas" FontSize="11" Foreground="#88FFFFFF" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>



            </Grid>

            <!-- 3.2 PANEL LATERAL DERECHO (TELEMETRÍA Y CONTROLES) -->
            <Border Grid.Column="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- SECCIÓN 1: TELEMETRÍA DINÁMICA -->
                        <Border Background="#181E2B" CornerRadius="5" Padding="10" Margin="0,0,0,10" BorderBrush="#252F42" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DINÁMICA DE TRACCIÓN" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8"/>
                                
                                <!-- PWM Motor -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Potencia Motor:" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="TxtTelemetryPWM" Text="0 PWM (0%)" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                </Grid>
                                <ProgressBar x:Name="BarPWM" Height="6" Minimum="0" Maximum="255" Value="0" Background="#0D1117" Foreground="{StaticResource AccentGreen}" BorderThickness="0" Margin="0,0,0,8"/>

                                <!-- Servo Dirección -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Ángulo Servo:" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="TxtTelemetrySteer" Text="95° (1500 µs)" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                </Grid>
                                <ProgressBar x:Name="BarSteer" Height="6" Minimum="46" Maximum="146" Value="95" Background="#0D1117" Foreground="{StaticResource AccentCyan}" BorderThickness="0" Margin="0,0,0,8"/>

                                <!-- Modos Activos -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" x:Name="BadgeSportState" Background="#202938" CornerRadius="3" Padding="4,2" Margin="0,0,3,0">
                                        <TextBlock x:Name="TxtSportState" Text="NORMAL [140]" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                    <Border Grid.Column="1" x:Name="BadgeTankState" Background="#202938" CornerRadius="3" Padding="4,2" Margin="3,0,0,0">
                                        <TextBlock x:Name="TxtTankState" Text="TANQUE: OFF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN 2: TELEMETRÍA DEL MANDO XBOX -->
                        <Border Background="#181E2B" CornerRadius="5" Padding="10" Margin="0,0,0,10" BorderBrush="#252F42" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MANDO XBOX ONE / SERIES" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Stick Izquierdo (X):" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="TxtJoyX" Text="0.00" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Gatillo RT (Avance):" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="TxtTrigRT" Text="0%" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Gatillo LT (Retroceso):" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="TxtTrigLT" Text="0%" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                </Grid>

                                <!-- Estado de botones directos -->
                                <WrapPanel Margin="0,4,0,0">
                                    <Border x:Name="BtnIndicatorA" Background="#1D2433" CornerRadius="3" Padding="6,2" Margin="2">
                                        <TextBlock Text="A (BOCINA)" FontSize="9" Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                    <Border x:Name="BtnIndicatorB" Background="#1D2433" CornerRadius="3" Padding="6,2" Margin="2">
                                        <TextBlock Text="B (PARADA)" FontSize="9" Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                    <Border x:Name="BtnIndicatorLB" Background="#1D2433" CornerRadius="3" Padding="6,2" Margin="2">
                                        <TextBlock Text="LB (SPORT)" FontSize="9" Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                    <Border x:Name="BtnIndicatorRB" Background="#1D2433" CornerRadius="3" Padding="6,2" Margin="2">
                                        <TextBlock Text="RB (TANQUE)" FontSize="9" Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN 3: RENDIMIENTO DE STREAM ESP32-CAM -->
                        <Border Background="#181E2B" CornerRadius="5" Padding="10" Margin="0,0,0,10" BorderBrush="#252F42" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MÉTRICAS VÍDEO (ESP32-CAM)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Tasa de Cuadros:" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="TxtDiagFps" Text="0.0 FPS" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentGreen}"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Latencia Frame:" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="TxtDiagLatency" Text="-- ms" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Total Cuadros:" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="TxtDiagTotalFrames" Text="0" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN 4: ACCIONES TÁCTICAS -->
                        <StackPanel Margin="0,0,0,10">
                            <Button x:Name="BtnHorn" Content="📢 ACTIVAR BOCINA / CLAXON (A)" Background="#2B3648" Margin="0,0,0,6" Click="BtnHorn_Click"/>
                        </StackPanel>

                        <!-- SECCIÓN 5: TERMINAL / LOG DE COMANDOS -->
                        <Border Background="#0D1017" CornerRadius="5" Padding="8" BorderBrush="#1C2330" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="TERMINAL DE COMANDOS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                    <Button Content="LIMPIAR" FontSize="9" Padding="4,1" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentCyan}" Click="BtnClearLog_Click"/>
                                </Grid>
                                <ScrollViewer x:Name="ScrollLog" Height="110" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtConsoleLog" Background="Transparent" Foreground="#00FF88" BorderThickness="0" FontFamily="Consolas" FontSize="10" IsReadOnly="True" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. STATUS FOOTER -->
        <Border Grid.Row="3" Background="#0B0E14" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFooterStatus" Text="SISTEMA LISTO. Conecte el mando de Xbox y el enlace al robot." FontSize="10" Foreground="{StaticResource TextDim}"/>
                <TextBlock Grid.Column="1" Text="UPV EPSA // PROMETHEUS TASKFORCE 2026" FontSize="10" Foreground="{StaticResource TextDim}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
